    L3__2["混合执行<br/><small>/api/hybrid · 工作流×Agent</small>"]
    L3__3["调度与日常<br/><small>delegate · report · schedule</small>"]
    L3__4["学习专项<br/><small>cet · path · checkin · profile</small>"]
    L3__5["进化与看板<br/><small>prompt-evo · admin · metrics</small>"]
