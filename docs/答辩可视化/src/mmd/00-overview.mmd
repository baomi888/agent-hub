    direction TB
    L7__0["systemd 三进程<br/><small>backend / frontend / worker</small>"]
    L7__1["APScheduler worker<br/><small>Asia/Shanghai · 7 个任务</small>"]
    L7__2["发布脚本<br/><small>deploy.sh · standalone 产物</small>"]
    L7__3["监控告警<br/><small>Prometheus + node-exporter</small>"]
    L7__4["健康探针<br/><small>/health · probe-health.sh</small>"]
    L7__5["备份与恢复<br/><small>SQLite + Chroma + 上传件</small>"]
    L7__6["HTTPS 与加固<br/><small>certbot · harden-server.sh</small>"]
  end
