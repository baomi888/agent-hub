    L4__4["检索流水线<br/><small>扩召回→BM25+RRF→MMR→top-k</small>"]
    L4__5["依据判定<br/><small>相似度 0.45 以下示弱</small>"]
    L4__6["上下文工程<br/><small>摘要块 + 最近 K 轮原文</small>"]
    L4__7["Prompt 版本库<br/><small>active / promote / rollback</small>"]
  end
  subgraph L5["数据与存储"]
    direction TB
    L5__0["会话库<br/><small>WAL · conversations/messages</small>"]
    L5__1["调度库<br/><small>jobs / job_runs / 心跳</small>"]
    L5__2["账号与配额<br/><small>accounts · usage · token 吊销</small>"]
    L5__3["Chroma 向量库<br/><small>每库一个 collection</small>"]
    L5__4["文档留档<br/><small>uploads · 文件清单</small>"]
    L5__5["画像与提示词<br/><small>user_tags · prompt_variants</small>"]
  end
  subgraph L6["外部服务与工具"]
    direction TB
    L6__0["DeepSeek<br/><small>deepseek-chat 对话</small>"]
    L6__1["百炼 Embedding<br/><small>text-embedding-v3</small>"]
    L6__2["百炼视觉<br/><small>qwen-vl-plus 看图</small>"]
