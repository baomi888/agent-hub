  classDef amber fill:#FFFBEB,stroke:#FDE68A,stroke-width:1px,color:#92400E
  classDef blue fill:#EFF6FF,stroke:#BFDBFE,stroke-width:1px,color:#1E40AF
  classDef green fill:#F0FDF4,stroke:#86EFAC,stroke-width:1px,color:#166534
