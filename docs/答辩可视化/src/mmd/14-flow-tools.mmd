%% 工具调用：模型只决定「用不用」，用谁的库由服务端决定
flowchart TB
  subgraph s1["① 模型决策"]
    direction TB
    s1__0["判断是否用工具<br/><small>由问题与提示词决定</small>"]
    s1__1["工具可见性<br/><small>按 use_kb / use_web 绑定</small>"]
    s1__2["生成参数<br/><small>StructuredTool schema</small>"]
  end
  subgraph s2["② 元数据校验"]
    direction TB
    s2__0["ToolMeta<br/><small>category / retryable / cost</small>"]
    s2__1["激活状态<br/><small>未激活工具直接拒绝</small>"]
    s2__2["needs_approval<br/><small>写操作挂起等确认</small>"]
    s2__3["prompt_guard<br/><small>注入 / 越权指令识别</small>"]
  end
  subgraph s3["③ 安全守卫"]
    direction TB
    s3__0["netsafe<br/><small>私网 / 回环地址拦截</small>"]
    s3__1["urltools<br/><small>下载许可清单</small>"]
    s3__2["参数校验<br/><small>类型 · 范围 · 长度</small>"]
  end
  subgraph s4["④ 执行工具"]
    direction TB
    s4__0["kb_search<br/><small>只读 · 归属库</small>"]
