    s4__2["get_weather<br/><small>高德 + Open-Meteo</small>"]
    s4__3["download_file<br/><small>唯一写操作 · 需审批</small>"]
  end
  subgraph s5["⑤ 回流与终止"]
    direction TB
    s5__0["输出截断<br/><small>4000 字 · 超限落盘</small>"]
    s5__1["tool 帧<br/><small>发起 / 返回都上屏</small>"]
    s5__2["模型继续<br/><small>ReAct ≤10 步</small>"]
    s5__3["终止<br/><small>给出答案或说明截断</small>"]
  end
