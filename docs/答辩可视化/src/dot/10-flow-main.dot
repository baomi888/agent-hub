  s5__0 -> s5__1 [ style=solid color="#64748B"];
  s5__1 -> s5__2 [ style=solid color="#64748B"];
  s6__0 -> s6__1 [ style=solid color="#64748B"];
  s6__1 -> s6__2 [ style=solid color="#64748B"];
  s6__2 -> s6__3 [ style=solid color="#64748B"];
  sa_s1_s2 -> sb_s1_s2 [ style=solid color="#64748B"];
  sa_s2_s3 -> sb_s2_s3 [ style=solid color="#64748B"];
  sa_s3_s4 -> sb_s3_s4 [label="按计划" style=solid color="#64748B"];
  sa_s4_s5 -> sb_s4_s5 [label="分支输出" style=solid color="#64748B"];
  sa_s5_s6 -> sb_s5_s6 [ style=solid color="#64748B"];
