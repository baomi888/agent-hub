    s2__2 [label="RRF 融合\nk=60 · 免分数对齐", fillcolor="#EFF6FF", color="#BFDBFE", fontcolor="#1E40AF"];
  }
  subgraph cluster_s3 {
    label="③ 精排与去冗"; fontsize=13; fontcolor="#5B21B6"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#DDD6FE";
    s3__0 [label="相似度阈值\n余弦 < 0.25 丢弃", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    s3__1 [label="MMR 去重\nλ=0.65 · 字符 2-gram", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    s3__2 [label="截断 top-k\n默认 3 · 上限 20", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
  }
  subgraph cluster_s4 {
    label="④ 依据判定"; fontsize=13; fontcolor="#92400E"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#FDE68A";
    s4__0 [label="相似度换算\n1 - distance / 2", fillcolor="#FFFBEB", color="#FDE68A", fontcolor="#92400E"];
    s4__1 [label="assess_grounding\n0.45 阈值分档", fillcolor="#FFFBEB", color="#FDE68A", fontcolor="#92400E"];
    s4__2 [label="三档结论\nstrong / medium / weak", fillcolor="#FFFBEB", color="#FDE68A", fontcolor="#92400E"];
  }
  subgraph cluster_s5 {
    label="⑤ 注入与作答"; fontsize=13; fontcolor="#1E293B"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#CBD5E1";
    s5__0 [label="sources 帧\n来源 · 页码 · 预览", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
    s5__1 [label="grounding 提示\n弱依据强制声明", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
    s5__2 [label="模型作答\n[1][2] 角标可回原文", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
