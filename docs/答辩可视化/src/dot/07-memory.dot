digraph "07-memory" {
  graph [rankdir=TB, fontname="Microsoft YaHei", bgcolor="#F7F8FA", nodesep=0.28, ranksep=0.38, compound=true];
  node [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=11, margin="0.12,0.08", penwidth=1.0];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#64748B", arrowsize=0.7];
  subgraph cluster_p1 {
    label="会话存储 · core/session.py"; fontsize=13; fontcolor="#1E293B"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#CBD5E1";
    p1__0 [label="conversations\nowner / title / kb_id / 更新时间", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
