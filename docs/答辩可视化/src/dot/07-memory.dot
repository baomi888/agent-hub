    p1__4 [label="窗口读取\n详情默认最近 10 轮", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
    p1__5 [label="整轮删除\nuser + 后续 assistant", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
  }
  subgraph cluster_p2 {
    label="上下文装配"; fontsize=13; fontcolor="#166534"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#86EFAC";
    p2__0 [label="摘要块\n长期记忆 · 置于历史前部", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p2__1 [label="最近 K 轮\n默认 6 · 扩展 12", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p2__2 [label="触发阈值\n字符占比达阈值才压", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p2__3 [label="全量判定\n按未截断历史算占用", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p2__4 [label="角色规范\nuser / assistant 成对", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p2__5 [label="降级\n摘要损坏回退原文", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
  }
  subgraph cluster_p3 {
    label="压缩与摘要 · context_compress"; fontsize=13; fontcolor="#166534"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#86EFAC";
    p3__0 [label="salience 打分\n信息密度 / 离群 / 实体", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p3__1 [label="抽取式压缩\n保留关键句 · 非生成式", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p3__2 [label="实体校验\n摘要必须覆盖原文实体", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p3__3 [label="安全阀\n压缩失败改用截断", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p3__4 [label="commit_summary\n版本号 · 幂等写入", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p3__5 [label="可追溯\n摘要与原文双存", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
  }
  subgraph cluster_p4 {
    label="画像与标签"; fontsize=13; fontcolor="#166534"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#86EFAC";
    p4__0 [label="user_tags\n对话后抽标签 · 权重累加", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p4__1 [label="user_tag_picks\n手选标签优先级更高", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p4__2 [label="profile 快照\n每日 02:30 聚合", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p4__3 [label="检索偏置\n命中标签的片段上浮", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p4__4 [label="词表约束\n30 条定稿标签", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    p4__5 [label="失败静默\n画像不影响主回答", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
  }
  subgraph cluster_p5 {
