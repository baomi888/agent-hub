    p5__5 [label="参数化查询\n无字符串拼接 SQL", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
  }
  subgraph cluster_p6 {
    label="会话生命周期"; fontsize=13; fontcolor="#1E293B"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#CBD5E1";
    p6__0 [label="首轮标题\n并行生成 · 失败保默认", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
