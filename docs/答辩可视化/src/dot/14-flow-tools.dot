digraph "14-flow-tools" {
  graph [rankdir=TB, fontname="Microsoft YaHei", bgcolor="#F7F8FA", nodesep=0.28, ranksep=0.38, compound=true];
  node [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=11, margin="0.12,0.08", penwidth=1.0];
  edge [fontname="Microsoft YaHei", fontsize=9, color="#64748B", arrowsize=0.7];
  subgraph cluster_s1 {
    label="① 模型决策"; fontsize=13; fontcolor="#92400E"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#FDE68A";
    s1__0 [label="判断是否用工具\n由问题与提示词决定", fillcolor="#FFFBEB", color="#FDE68A", fontcolor="#92400E"];
    s1__1 [label="工具可见性\n按 use_kb / use_web 绑定", fillcolor="#FFFBEB", color="#FDE68A", fontcolor="#92400E"];
    s1__2 [label="生成参数\nStructuredTool schema", fillcolor="#FFFBEB", color="#FDE68A", fontcolor="#92400E"];
  }
  subgraph cluster_s2 {
    label="② 元数据校验"; fontsize=13; fontcolor="#1E40AF"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#BFDBFE";
    s2__0 [label="ToolMeta\ncategory / retryable / cost", fillcolor="#EFF6FF", color="#BFDBFE", fontcolor="#1E40AF"];
    s2__1 [label="激活状态\n未激活工具直接拒绝", fillcolor="#EFF6FF", color="#BFDBFE", fontcolor="#1E40AF"];
    s2__2 [label="needs_approval\n写操作挂起等确认", fillcolor="#EFF6FF", color="#BFDBFE", fontcolor="#1E40AF"];
    s2__3 [label="prompt_guard\n注入 / 越权指令识别", fillcolor="#EFF6FF", color="#BFDBFE", fontcolor="#1E40AF"];
  }
  subgraph cluster_s3 {
    label="③ 安全守卫"; fontsize=13; fontcolor="#5B21B6"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#DDD6FE";
    s3__0 [label="netsafe\n私网 / 回环地址拦截", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    s3__1 [label="urltools\n下载许可清单", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    s3__2 [label="参数校验\n类型 · 范围 · 长度", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
  }
  subgraph cluster_s4 {
    label="④ 执行工具"; fontsize=13; fontcolor="#166534"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#86EFAC";
    s4__0 [label="kb_search\n只读 · 归属库", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    s4__1 [label="web_search\n只读 · 写下载白名单", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    s4__2 [label="get_weather\n高德 + Open-Meteo", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
    s4__3 [label="download_file\n唯一写操作 · 需审批", fillcolor="#F0FDF4", color="#86EFAC", fontcolor="#166534"];
  }
  subgraph cluster_s5 {
    label="⑤ 回流与终止"; fontsize=13; fontcolor="#1E293B"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#CBD5E1";
    s5__0 [label="输出截断\n4000 字 · 超限落盘", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
    s5__1 [label="tool 帧\n发起 / 返回都上屏", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
    s5__2 [label="模型继续\nReAct ≤10 步", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
    s5__3 [label="终止\n给出答案或说明截断", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
  }
  s1__0 -> s1__1 [ style=solid color="#64748B"];
  s1__1 -> s1__2 [ style=solid color="#64748B"];
  s2__0 -> s2__1 [ style=solid color="#64748B"];
  s2__1 -> s2__2 [ style=solid color="#64748B"];
  s2__2 -> s2__3 [ style=solid color="#64748B"];
  s3__0 -> s3__1 [ style=solid color="#64748B"];
  s3__1 -> s3__2 [ style=solid color="#64748B"];
  s4__0 -> s4__1 [ style=solid color="#64748B"];
  s4__1 -> s4__2 [ style=solid color="#64748B"];
  s4__2 -> s4__3 [ style=solid color="#64748B"];
  s5__0 -> s5__1 [ style=solid color="#64748B"];
  s5__1 -> s5__2 [ style=solid color="#64748B"];
  s5__2 -> s5__3 [ style=solid color="#64748B"];
  sa_s1_s2 -> sb_s1_s2 [ style=solid color="#64748B"];
  sa_s2_s3 -> sb_s2_s3 [ style=solid color="#64748B"];
