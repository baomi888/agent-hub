    p2__0 [label="旧 mode 映射\nrag / llm / agent / hybrid", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p2__1 [label="router.decide\n轻量 LLM · 2s 超时", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p2__2 [label="workflow 判定\n命中且开关开启 → hybrid", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p2__3 [label="无工具退化\nuse_kb/use_web 都关 → llm", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p2__4 [label="库不存在\nrag → agent", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p2__5 [label="失败兜底\n超时 / 坏格式 → agent", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
  }
  subgraph cluster_p3 {
    label="四个执行分支"; fontsize=13; fontcolor="#5B21B6"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#DDD6FE";
    p3__0 [label="hybrid\n工作流 × Agent · 可人工切换", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p3__1 [label="agent\nReAct 循环 · 四工具", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p3__2 [label="rag\n改写 → 检索 → 拼参考资料", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p3__3 [label="llm\n纯对话 · 压缩历史", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p3__4 [label="vision\nqwen-vl 看图 · 可叠加检索", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p3__5 [label="兜底\n混合零产出 → 纯 LLM 再答", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
  }
  subgraph cluster_p4 {
    label="上下文组装 · 请求路径"; fontsize=13; fontcolor="#1E293B"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#CBD5E1";
    p4__0 [label="系统提示词\nprompt_store active 版本", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
