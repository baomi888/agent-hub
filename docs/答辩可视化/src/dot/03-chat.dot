    p1__3 [label="知识库归属\n非本人库按未绑定", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p1__4 [label="图片分支\n有图直接进 vision", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
    p1__5 [label="计划主题\n追问时从历史续主题", fillcolor="#F5F3FF", color="#DDD6FE", fontcolor="#5B21B6"];
  }
  subgraph cluster_p2 {
