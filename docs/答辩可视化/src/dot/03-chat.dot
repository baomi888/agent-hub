    label="收尾与副作用"; fontsize=13; fontcolor="#1E293B"; style="rounded,filled"; fillcolor="#FFFFFF"; color="#CBD5E1";
    p6__0 [label="落库 assistant\nrefs / truncated 一并记", fillcolor="#F1F5F9", color="#CBD5E1", fontcolor="#1E293B"];
