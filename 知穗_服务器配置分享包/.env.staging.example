# ================= Staging 环境配置模板 =================
#
# 用法：复制为 .env.staging 并填入真实值（.env.staging 已被 .gitignore 忽略，切勿提交）
#     cp .env.staging.example .env.staging
#     nano .env.staging
#
# ⚠️ 与生产 .env 的关系：**完全独立的一套**。staging 与生产在同一台 ECS 上
#    分端口并存（生产 3000/8000，staging 3001/8001），靠下面这三件事隔离：
#      1) 不同端口   —— deploy-staging.sh 里写死，不在此文件配置
#      2) 不同数据目录 —— DATA_DIR / PERSIST_DIR，**本文件最重要的一项**
#      3) 不同密钥   —— AUTH_SECRET 必须与生产不同
#
# ⚠️ 红线：DATA_DIR / PERSIST_DIR 绝不能指向生产的 data / chroma_db。
#    一旦共用，staging 的测试数据会污染生产用户，chroma 并发写还可能损坏索引。

# ---------- 大模型（DeepSeek Chat）----------
DEEPSEEK_API_KEY=在此粘贴你的DeepSeek_API_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- Embedding（阿里百炼 text-embedding-v3）----------
# DeepSeek 不提供 embedding 接口，必须单独配向量化服务
EMBEDDING_API_KEY=在此粘贴你的百炼DashScope_API_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ---------- 路径（★ staging 隔离的核心，务必改成独立的）----------
DATA_DIR=data-staging
PERSIST_DIR=chroma-staging
DOWNLOAD_DIR=downloads-staging

# ---------- 默认参数（与生产保持一致即可）----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
EMBED_BATCH_SIZE=10

# ---------- 可选：天气 / 联网搜索 ----------
AMAP_API_KEY=
SERPER_API_KEY=

# ---------- 登录与配额（staging 可放宽，方便联调）----------
# ★ 必须与生产不同！否则拿 staging 的 token 可能打到生产。
#   生成一个长随机串：openssl rand -hex 32
AUTH_SECRET=
# staging 建议开放自助注册，方便队友与测试同学建号
ALLOW_SIGNUP=1
AUTH_TTL_DAYS=7
# 联调时限流放宽一些，避免正常测试被 429 打断
# （生产值是 RATE_PER_MINUTE=10 / DAILY_ASK_LIMIT=60）
RATE_PER_MINUTE=60
DAILY_ASK_LIMIT=0
# ⚠️ 即使 staging，也不要轻易把 DAILY_EMBED_LIMIT 设 0：
#    embedding 按 token 计费，一次建库几千片，这是防账单事故的闸门。
DAILY_EMBED_LIMIT=2000
# 管理员用户名（逗号分隔）。staging 上把自己加上，方便手工触发调度任务
# （/api/schedule/run-now 与 /api/schedule/retry 需要管理员）。
ADMIN_USERNAMES=苞米呀
