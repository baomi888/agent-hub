[Unit]
Description=ZhiSui Agent - frontend (next start 0.0.0.0:3000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
# 直接 exec next 二进制，不用 npm 包一层（避免 npm 退出后 next 子进程成孤儿）
ExecStart=__APP_DIR__/frontend/node_modules/.bin/next start -p 3000
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
