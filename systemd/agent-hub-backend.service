[Unit]
Description=ZhiSui Agent - backend (uvicorn 127.0.0.1:8000)
Documentation=https://github.com/baomi888/agent-hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
Environment=PYTHONUTF8=1
Environment=PYTHONDONTWRITEBYTECODE=1
# 注意：不配 EnvironmentFile —— 后端 core/config.py 自己 load_dotenv(.env)，
# 避免 systemd 解析 .env 时因中文/引号报错导致起不来。
# --workers __WORKERS__：由 install-systemd.sh 按 vCPU / 内存探测后替换（WORKERS=1 即单进程）。
# 多进程下进程内状态各存一份：每分钟限流强度变为 N 倍、LLM 并发闸全局上限 = N × LLM_MAX_CONCURRENCY。
ExecStart=__APP_DIR__/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers __WORKERS__
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
