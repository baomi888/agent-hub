# ================= 集合式 Agent 配置模板 =================
# 安全提醒：真实 .env 含密钥，已加入 .gitignore，严禁提交 GitHub！
# 本文件只是模板，只放占位符，永远不要填真实密钥。
# 复制一份为 .env，填入你的真实 Key。

# ---------- 大模型（DeepSeek Chat）----------
DEEPSEEK_API_KEY=在此粘贴你的DeepSeek_API_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- Embedding（阿里百炼 text-embedding-v3）----------
# DeepSeek 不提供 embedding 接口，必须单独配向量化服务
EMBEDDING_API_KEY=在此粘贴你的百炼DashScope_API_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ---------- 路径 ----------
DATA_DIR=data
PERSIST_DIR=chroma_db

# ---------- 默认参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
EMBED_BATCH_SIZE=10

# ---------- 可选：天气工具（高德）----------
AMAP_API_KEY=

# ---------- 可选：联网搜索备选（Serper）----------
SERPER_API_KEY=

# ---------- 登录与配额（多用户隔离）----------
# AUTH_SECRET：签发登录令牌的密钥。留空会自动生成并存到 data/.auth_secret，
#   但**换一台机器或删了 data 目录会让所有人掉登录**，正式部署建议显式设一个长随机串。
AUTH_SECRET=
# 是否开放自助注册。演示给老师/同学看时保持 1；想只给自己用就设 0（设 0 后
#   仍可用 tools/migrate_owner.py 之外的方式建号：临时改回 1 注册完再改 0）。
ALLOW_SIGNUP=1
# 登录有效期（天）
AUTH_TTL_DAYS=7
# 每人每分钟请求上限（防脚本刷接口，不区分接口）。保守值：正常人类用不完
RATE_PER_MINUTE=10
# 每人每日问答次数上限，0 = 不限。保守值：亲友闲聊足够
DAILY_ASK_LIMIT=60
# 每人每日向量化片段数上限，0 = 不限。embedding 按 token 计费，
#   一次建库几千片，这个值是防账单事故的闸门，别轻易设 0。保守值：约够一本几百页的文档
DAILY_EMBED_LIMIT=1000
# 管理员用户名（逗号分隔）。管理员不受上面所有配额/限流约束，相当于主账号。
#   默认已含"苞米呀"（项目作者账号）；换部署时改成你自己的用户名，
#   例如 ADMIN_USERNAMES=admin,alice。留空则没有管理员。
ADMIN_USERNAMES=苞米呀

# ---------------- 并发与 LLM 闸 ----------------
# 后端 uvicorn worker 数。留空/不写 = deploy.sh 自动探测（vCPU 与内存取小，最多 4，
#   内存 < 3G 时封顶 2）；写 1 = 单进程（回退到改造前的行为）。
#   注意：以下两项是**每进程**的值，多 worker 时全局上限 = workers × 该值。
WORKERS=
# 每进程允许同时打到上游 LLM 的问答轮数。0 = 关闭闸门（不限，不建议）。
#   200 人同时提问时，超出的人排队而不是一起打爆上游；按你的账号额度调。
LLM_MAX_CONCURRENCY=16
# 排队超时（秒）：抢不到名额最多等这么久，超时返回 429 + Retry-After。
#   太大等于让用户干等，太小会在峰值把本来能排上的请求也拒掉。20 秒折中。
LLM_QUEUE_TIMEOUT=20
# 一键关闸（排障用）：0 时行为回到"不限制"，/health 里 llm_gate.enabled 变 false。
LLM_GATE_ENABLED=1
