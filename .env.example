# ================= 集合式 Agent 配置模板 =================
# 安全提醒：真实 .env 含密钥，已加入 .gitignore，严禁提交 GitHub！
# 本文件只是模板，只放占位符，永远不要填真实密钥。
# 复制一份为 .env，填入你的真实 Key。

# ---------- 大模型（DeepSeek Chat）----------
DEEPSEEK_API_KEY=在此粘贴你的DeepSeek_API_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- Embedding（阿里百炼 text-embedding-v3）----------
# DeepSeek 不提供 embedding 接口，必须单独配向量化服务
EMBEDDING_API_KEY=在此粘贴你的百炼DashScope_API_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ---------- 路径 ----------
DATA_DIR=data
PERSIST_DIR=chroma_db

# ---------- 默认参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
EMBED_BATCH_SIZE=10

# ---------- 可选：天气工具（高德）----------
AMAP_API_KEY=

# ---------- 可选：联网搜索备选（Serper）----------
SERPER_API_KEY=

# ---------- 登录与配额（多用户隔离）----------
# AUTH_SECRET：签发登录令牌的密钥。留空会自动生成并存到 data/.auth_secret，
#   但**换一台机器或删了 data 目录会让所有人掉登录**，正式部署建议显式设一个长随机串。
AUTH_SECRET=
# 是否开放自助注册。演示给老师/同学看时保持 1；想只给自己用就设 0（设 0 后
#   仍可用 tools/migrate_owner.py 之外的方式建号：临时改回 1 注册完再改 0）。
ALLOW_SIGNUP=1
# 登录有效期（天）
AUTH_TTL_DAYS=7
# 每人每分钟请求上限（防脚本刷接口，不区分接口）。保守值：正常人类用不完
RATE_PER_MINUTE=10
# 每人每日问答次数上限，0 = 不限。保守值：亲友闲聊足够
DAILY_ASK_LIMIT=60
# 每人每日向量化片段数上限，0 = 不限。embedding 按 token 计费，
#   一次建库几千片，这个值是防账单事故的闸门，别轻易设 0。保守值：约够一本几百页的文档
DAILY_EMBED_LIMIT=1000
# 管理员用户名（逗号分隔）。管理员不受上面所有配额/限流约束，相当于主账号。
#   默认已含"苞米呀"（项目作者账号）；换部署时改成你自己的用户名，
#   例如 ADMIN_USERNAMES=admin,alice。留空则没有管理员。
ADMIN_USERNAMES=苞米呀
